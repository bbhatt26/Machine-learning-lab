    "import pandas as pd\n",
    "df = pd.read_csv(r\"C:\\Users\\bhatt\\Desktop\\sample2.csv\")\n",
    "Q1=df['fare'].quantile(0.25); Q3=df['fare'].quantile(0.75); IQR=Q3-Q1\n",
    "df_no_out=df[~((df['fare']<Q1-1.5*IQR)|(df['fare']>Q3+1.5*IQR))]\n",
    "print(df.shape, df_no_out.shape)"
